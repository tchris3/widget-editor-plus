# ServiceNow PDI Target Instance Configuration for Playwright E2E Tests
# Copy this file to .env and fill in your PDI credentials before running tests:
#   cp .env.example .env

SN_INSTANCE_URL=https://devXXXXX.service-now.com
SN_USERNAME=admin
SN_PASSWORD=your_password_here
SN_PORTAL_SUFFIX=sp
SN_UPDATE_SET=Default
SN_CLEANUP_TEST_DATA=true

# Optional 2nd user with sp_admin role for testing multi-user presence (test skips if unconfigured):
SN_USER2_USERNAME=
SN_USER2_PASSWORD=
